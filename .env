# Images. Upstream images are published to Docker Hub as well as GHCR; Docker Hub is used so the
# stack pulls from the same registry everywhere.
IMAGE_VERSION=3.1.0
IMAGE_NAME=docker.io/otel/demo

# Build args (only used when building images from source)
OTEL_JAVA_AGENT_VERSION=2.31.1
OPENTELEMETRY_CPP_VERSION=1.28.0

# Dependent images
COLLECTOR_CONTRIB_IMAGE=docker.io/otel/opentelemetry-collector-contrib:0.160.0
FLAGD_IMAGE=ghcr.io/open-feature/flagd:v0.16.0
POSTGRES_IMAGE=docker.io/library/postgres:18.6
VALKEY_IMAGE=docker.io/valkey/valkey:9.1.2-alpine

# Observability stack A
PROMETHEUS_IMAGE=docker.io/prom/prometheus:v3.13.5
ALERTMANAGER_IMAGE=docker.io/prom/alertmanager:v0.34.2
LOKI_IMAGE=docker.io/grafana/loki:3.6.19
TEMPO_IMAGE=docker.io/grafana/tempo:2.10.10
GRAFANA_IMAGE=docker.io/grafana/grafana:13.2.5

ENV_PLATFORM=local
IPV6_ENABLED=false

# OpenTelemetry Collector
DOCKER_SOCK=/var/run/docker.sock
OTEL_COLLECTOR_HOST=otel-collector
OTEL_COLLECTOR_PORT_GRPC=4317
OTEL_COLLECTOR_PORT_HTTP=4318
OTEL_COLLECTOR_CONFIG=./observability/stack-a/otelcol-config.yml
OTEL_EXPORTER_OTLP_ENDPOINT=http://${OTEL_COLLECTOR_HOST}:${OTEL_COLLECTOR_PORT_GRPC}
PUBLIC_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:8080/otlp-http/v1/traces

# OpenTelemetry resource
OTEL_SERVICE_NAMESPACE=shopfront
OTEL_RESOURCE_ATTRIBUTES=service.namespace=${OTEL_SERVICE_NAMESPACE},service.version=${IMAGE_VERSION},deployment.environment.name=demo

# Metrics options
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative
OTEL_EXPORTER_OTLP_METRICS_DEFAULT_HISTOGRAM_AGGREGATION=explicit_bucket_histogram

# ******************
# Services
# ******************
ACCOUNTING_DOCKERFILE=./src/accounting/Dockerfile

AD_PORT=9555
AD_ADDR=ad:${AD_PORT}
AD_PROMETHEUS_PORT=9465
AD_DOCKERFILE=./src/ad/Dockerfile

CART_PORT=7070
CART_ADDR=cart:${CART_PORT}
CART_DOCKERFILE=./src/cart/src/Dockerfile

CHECKOUT_PORT=5050
CHECKOUT_ADDR=checkout:${CHECKOUT_PORT}
CHECKOUT_DOCKERFILE=./src/checkout/Dockerfile

CURRENCY_PORT=7001
CURRENCY_ADDR=currency:${CURRENCY_PORT}
CURRENCY_DOCKERFILE=./src/currency/Dockerfile

EMAIL_PORT=6060
EMAIL_ADDR=http://email:${EMAIL_PORT}
EMAIL_DOCKERFILE=./src/email/Dockerfile

ENVOY_ADDR=0.0.0.0
ENVOY_PORT=8080
ENVOY_ADMIN_PORT=10000
FRONTEND_HOST=frontend
FRONTEND_PROXY_ADDR=frontend-proxy:${ENVOY_PORT}
FRONTEND_PROXY_DOCKERFILE=./src/frontend-proxy/Dockerfile

FRONTEND_PORT=8080
FRONTEND_ADDR=${FRONTEND_HOST}:${FRONTEND_PORT}
FRONTEND_DOCKERFILE=./src/frontend/Dockerfile

IMAGE_PROVIDER_HOST=image-provider
IMAGE_PROVIDER_PORT=8081
IMAGE_PROVIDER_DOCKERFILE=./src/image-provider/Dockerfile

LOCUST_WEB_PORT=8089
LOCUST_USERS=20
LOCUST_HOST=http://${FRONTEND_PROXY_ADDR}
LOCUST_WEB_HOST=load-generator
LOCUST_AUTOSTART=true
LOCUST_HEADLESS=false
# Browser (Playwright) users cost about 1 GB of memory; off by default.
LOCUST_BROWSER_TRAFFIC_ENABLED=false
LOCUST_HTTP_USER_WEIGHT=9
LOCUST_BROWSER_USER_WEIGHT=1
LOAD_GENERATOR_DOCKERFILE=./src/load-generator/Dockerfile

PAYMENT_PORT=50051
PAYMENT_ADDR=payment:${PAYMENT_PORT}
PAYMENT_DOCKERFILE=./src/payment/Dockerfile

PRODUCT_CATALOG_PORT=3550
PRODUCT_CATALOG_ADDR=product-catalog:${PRODUCT_CATALOG_PORT}
PRODUCT_CATALOG_DOCKERFILE=./src/product-catalog/Dockerfile

QUOTE_PORT=8090
QUOTE_ADDR=http://quote:${QUOTE_PORT}
QUOTE_DOCKERFILE=./src/quote/Dockerfile

RECOMMENDATION_PORT=9001
RECOMMENDATION_ADDR=recommendation:${RECOMMENDATION_PORT}
RECOMMENDATION_DOCKERFILE=./src/recommendation/Dockerfile

SHIPPING_PORT=50050
SHIPPING_ADDR=http://shipping:${SHIPPING_PORT}
SHIPPING_DOCKERFILE=./src/shipping/Dockerfile

# ******************
# Dependencies
# ******************
FLAGD_HOST=flagd
FLAGD_PORT=8013
FLAGD_OFREP_PORT=8016

KAFKA_PORT=9092
KAFKA_HOST=kafka
KAFKA_ADDR=${KAFKA_HOST}:${KAFKA_PORT}
KAFKA_TOPIC=orders
KAFKA_DOCKERFILE=./src/kafka/Dockerfile

VALKEY_PORT=6379
VALKEY_ADDR=valkey-cart:${VALKEY_PORT}

# Local demo database; the passwords are defined in src/postgresql/init.sql.
POSTGRES_HOST=astronomy-db
POSTGRES_PORT=5432
POSTGRES_PASSWORD=changeit
POSTGRES_ASTRONOMY_PASSWORD=astronomy_password
POSTGRES_MONITORING_PASSWORD=monitoring_password

# ******************
# Observability
# ******************
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
TEMPO_PORT=3200
GRAFANA_PORT=3000
