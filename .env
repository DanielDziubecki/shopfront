# Service versions (also reported as service.version in telemetry)
STOREFRONT_VERSION=1.3.0
CATALOG_VERSION=2.1.4
CART_VERSION=1.2.0
CHECKOUT_VERSION=1.6.2
PAYMENT_VERSION=1.8.1
SHIPPING_VERSION=1.4.1
RECOMMENDATION_VERSION=0.9.3
FULFILLMENT_VERSION=1.1.0
LOADGEN_VERSION=1.0.0

# Service settings
CATALOG_TEXT_NORMALIZATION=none
PAYMENT_TOKEN_CACHE=v1
RECOMMENDATION_CACHE=v1
LOADGEN_USERS=20
DEPLOYMENT_ENVIRONMENT=demo

# Local demo credentials
POSTGRES_PASSWORD=shop
RABBITMQ_PASSWORD=shop

# Ports on localhost
STOREFRONT_PORT=8080
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
TEMPO_PORT=3200
GRAFANA_PORT=3000
RABBITMQ_UI_PORT=15672

# Infrastructure images
POSTGRES_IMAGE=docker.io/library/postgres:18.6
VALKEY_IMAGE=docker.io/valkey/valkey:9.1.2-alpine
RABBITMQ_IMAGE=docker.io/library/rabbitmq:4.1.8-management-alpine
COLLECTOR_IMAGE=docker.io/otel/opentelemetry-collector-contrib:0.160.0
PROMETHEUS_IMAGE=docker.io/prom/prometheus:v3.13.5
ALERTMANAGER_IMAGE=docker.io/prom/alertmanager:v0.34.2
LOKI_IMAGE=docker.io/grafana/loki:3.6.19
TEMPO_IMAGE=docker.io/grafana/tempo:2.10.10
GRAFANA_IMAGE=docker.io/grafana/grafana:13.2.5

# OpenTelemetry Collector
DOCKER_SOCK=/var/run/docker.sock
OTEL_COLLECTOR_CONFIG=./observability/stack-a/otelcol-config.yml
